# ~/.ssh/config, shipped by the Onsen edition (etc/skel/.ssh/config) and
# kept current by onsen update. Hosts and keys that stay off the fork go in
# ~/.ssh/config.d/*.conf; the Include loads them first and onsen never
# touches that directory.

Include config.d/*.conf

# Tell gpg-agent which terminal a PIN prompt may use, for the times
# pinentry-smart has to fall back to a terminal pinentry. --no-autostart:
# the agent is smartsocket's socket-activated gpg-agent-local, never one ssh
# starts on its own. /bin/sh: Match exec runs under $SHELL, and nushell
# rejects '&&'. Interactive sessions only.
Match host * exec "/bin/sh -c 'test -t 0 && gpg-connect-agent --no-autostart UPDATESTARTUPTTY /bye'"

# The forges authenticate with the YubiKey. IdentityAgent pins smartsocket's
# socket at the standard gpg-agent path: the card in this machine, or the one
# in nimbus while nimbus is connected and forwarding its agent. So a session
# that arrived with its own forwarded agent still offers the card key here,
# not the first key of the agent it brought.
Host github.com
  User git
  IdentityAgent /run/user/1000/gnupg/S.gpg-agent.ssh

Host src.kingland.io gitea
  HostName src.kingland.io
  User gitea
  IdentityAgent /run/user/1000/gnupg/S.gpg-agent.ssh

# stratus drops off Wi-Fi now and then; keep its sessions alive harder.
# Before Host *: ssh keeps the first value it finds for each option.
Host stratus
  ServerAliveInterval 15
  ServerAliveCountMax 4

Host *
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  AddKeysToAgent no
  ForwardAgent no
