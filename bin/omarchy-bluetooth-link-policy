#!/usr/bin/python3
# omarchy:summary=Keep a Bluetooth input device's link out of sniff mode
# omarchy:args=[address]
# omarchy:hidden=true
# omarchy:requires-sudo=true
"""Strip SNIFF from the link policy of a BR/EDR link on hci0.

The Magic Trackpad on the TP-Link UB500 (RTL8761BU) stops delivering input
while its link is in sniff mode: bluez reports it connected and battery reads
still answer, but touches queue up in the trackpad until the host sends Exit
Sniff Mode. With SNIFF off in the link policy the controller refuses the
trackpad's sniff requests and the link stays active.

The kernel rejects HCISETLINKPOL (the adapter-wide default) on this build,
and bluez has no setting for it, so the policy is written per link with Write
Link Policy Settings. udev runs this with the trackpad's address when its HID
input device appears (etc/udev/rules.d/70-onsen-bluetooth-link-policy.rules);
without an address every BR/EDR link gets the policy. Needs root for the raw
HCI socket.
"""
import fcntl
import socket
import struct
import sys

AF_BLUETOOTH, BTPROTO_HCI = 31, 1
HCIGETCONNLIST = (2 << 30) | (4 << 16) | (ord("H") << 8) | 212
ACL_LINK = 0x01
WRITE_LINK_POLICY = 0x080D
POLICY = 0x000B  # role switch, hold, park: everything but sniff
MAX_CONNS = 16


def main() -> int:
    wanted = sys.argv[1].upper() if len(sys.argv) > 1 else None
    sock = socket.socket(AF_BLUETOOTH, socket.SOCK_RAW, BTPROTO_HCI)
    # struct hci_conn_list_req { u16 dev_id; u16 conn_num; struct hci_conn_info conn_info[]; }
    # struct hci_conn_info { u16 handle; bdaddr_t bdaddr; u8 type; u8 out; u16 state; u32 link_mode; }
    req = bytearray(struct.pack("<HH", 0, MAX_CONNS) + bytes(16 * MAX_CONNS))
    fcntl.ioctl(sock, HCIGETCONNLIST, req)
    count = struct.unpack_from("<H", req, 2)[0]
    sock.bind((0,))
    written = 0
    for i in range(count):
        handle, *bdaddr, link_type, _out, _state, _mode = struct.unpack_from("<H6BBBHI", req, 4 + 16 * i)
        if link_type != ACL_LINK:
            continue
        address = ":".join("%02X" % byte for byte in reversed(bdaddr))
        if wanted and address != wanted:
            continue
        sock.send(b"\x01" + struct.pack("<HBHH", WRITE_LINK_POLICY, 4, handle, POLICY))
        print(f"hci0 handle {handle} {address}: link policy 0x{POLICY:04x}")
        written += 1
    if not written:
        print(f"no BR/EDR link to {wanted}" if wanted else "no BR/EDR links", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
