#!/bin/bash
# Onsen: the current tmux window's pill and the active pane border in a green
# drawn from the active theme. A raw theme green is too loud as a pill, so the
# pill is the theme's green mixed into its background, with the theme's own
# text colour on it, and the border is a brighter mix. Runs on every theme
# switch, and from tmux.conf when the server starts. Sets @onsen_pill,
# @onsen_pill_fg and pane-active-border-style; tmux.conf reads the first two.

tmux list-sessions >/dev/null 2>&1 || exit 0

color() { omarchy-theme-color "$1" "$2" 2>/dev/null || printf '%s' "$2"; }

# mix <colour> <into> <percent of colour>
mix() {
  local a=${1#\#} b=${2#\#} p=$3 i out=""
  for i in 0 2 4; do
    out+=$(printf '%02x' $(( (16#${a:i:2} * p + 16#${b:i:2} * (100 - p) + 50) / 100 )))
  done
  printf '#%s' "$out"
}

green=$(color green '#9ece6a')
background=$(color background '#1a1b26')
if [[ $(color mode dark) == light ]]; then
  text=$(color foreground '#343b58')
else
  text=$(color bright_foreground '#c0caf5')
fi

tmux set -g @onsen_pill "$(mix "$green" "$background" 40)" \; \
     set -g @onsen_pill_fg "$text" \; \
     set -g pane-active-border-style "fg=$(mix "$green" "$background" 70)" \; \
     refresh-client -S 2>/dev/null
