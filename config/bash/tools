# Tool wrappers: Bitwarden, Jira, and Linode. Sourced by ~/.config/bash/rc.
# No secret lives here; each token is read from Bitwarden when the command
# runs. bw-unlock writes the session the other wrappers use.

bw-unlock() {
  mkdir -p ~/.config/bw
  command bw unlock --raw > ~/.config/bw/session
  chmod 600 ~/.config/bw/session
}

# Bitwarden (session from the shared unlock file).
# login and unlock have to work before that file exists. Reading a
# missing file prints an error and would pass --session "" through.
bw() {
  local session=""
  if [[ -r ${HOME}/.config/bw/session ]]; then
    session=$(<"${HOME}/.config/bw/session")
  fi
  case "${1:-}" in
    login|logout|config|help|--help|-h)
      command bw "$@"
      ;;
    *)
      if [[ -n $session ]]; then
        command bw --session "$session" "$@"
      else
        command bw "$@"
      fi
      ;;
  esac
}

# Jira CLI (token from Bitwarden)
jira() {
  JIRA_API_TOKEN=$(bw get password "jira token") command jira "$@"
}

# Linode CLI: the agent/ops high-auth PAT (no Object Storage write).
# Backup OS mutation is linode-backups-token only; never wire it here.
linode-cli() {
  LINODE_CLI_TOKEN=$(bw get password linode-cli-token) command linode-cli "$@"
}
